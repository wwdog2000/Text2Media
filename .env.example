# Alibaba Cloud Model Studio / DashScope
DASHSCOPE_API_KEY=
# International endpoint example. Use the endpoint that matches your API key region.
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/api/v1
DASHSCOPE_MODEL=qwen3-tts-flash
DASHSCOPE_VOICE=Cherry

# Optional font path for Chinese subtitle rendering
# macOS example:
TEXT2MEDIA_FONT=/System/Library/Fonts/PingFang.ttc
